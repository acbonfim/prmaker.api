<Project Sdk="Microsoft.NET.Sdk">

    <!-- Migra dados para o PostgreSQL: perfil "auth" (SQL Server, feature 0014) e "prform" (MySQL, feature 0015). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Cime.DataMigrator</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" />
        <PackageReference Include="MySqlConnector" Version="2.3.5" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Os modelos EF de destino: tabelas, colunas, chaves e migrações vêm daqui. -->
        <ProjectReference Include="..\..\CIME\modules\Cime.Auth\src\cime.auth.api\cime.auth.api.csproj" />
        <ProjectReference Include="..\..\CIME\modules\Solvace.PullRequests\src\solvace.prform.infra\solvace.prform.infra.csproj" />
        <ProjectReference Include="..\..\CIME\modules\Solvace.Vacations\src\solvace.vacations.infra\solvace.vacations.infra.csproj" />
        <ProjectReference Include="..\..\CIME\modules\Solvace.Timeline\src\solvace.timeline.infra\solvace.timeline.infra.csproj" />
    </ItemGroup>

</Project>
