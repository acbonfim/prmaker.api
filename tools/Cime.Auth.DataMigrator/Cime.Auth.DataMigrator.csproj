<Project Sdk="Microsoft.NET.Sdk">

    <!-- Ferramenta da feature 0014: migra os dados da Cime.Auth do SQL Server para o PostgreSQL. -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>Cime.Auth.DataMigrator</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
        <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Para o comando "schema" aplicar exatamente as migrações da auth. -->
        <ProjectReference Include="..\..\CIME\modules\Cime.Auth\src\cime.auth.api\cime.auth.api.csproj" />
    </ItemGroup>

</Project>
