{
  "requires": [
    "curl",
    "jq",
    "python3"
  ],
  "depends": [
    "analisar-bug"
  ],
  "setup": {
    "check": "[ -x .venv/bin/python ]",
    "run": "python3 -m venv .venv",
    "windows": {
      "check": "[ -x .venv/Scripts/python.exe ]",
      "run": "python3 -m venv .venv"
    }
  }
}
