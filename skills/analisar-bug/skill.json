{
  "requires": [
    "curl",
    "jq",
    "python3"
  ],
  "optional": [
    "aws"
  ],
  "depends": [
    "base-solvace",
    "engenharia-reversa"
  ],
  "setup": {
    "check": "[ -x .venv/bin/python ] && .venv/bin/python -c 'import pytds' 2>/dev/null",
    "run": "python3 -m venv .venv && .venv/bin/pip install -q python-tds",
    "windows": {
      "check": "[ -x .venv/Scripts/python.exe ] && .venv/Scripts/python.exe -c 'import pytds' 2>/dev/null",
      "run": "python3 -m venv .venv && .venv/Scripts/python.exe -m pip install -q python-tds"
    }
  }
}
