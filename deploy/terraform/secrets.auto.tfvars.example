# Copie para  secrets.auto.tfvars  (gitignorado) e preencha com os valores REAIS.
# O Terraform cria um Secret Manager secret + versão para cada chave abaixo.
#
# ATENÇÃO: as chaves atuais estão versionadas no git (appsettings.json). Rotacione-as
# (gere novas senhas/tokens) antes de colocar em produção.

project_id  = "seu-projeto-gcp"
region      = "us-central1"
github_repo = "acbonfim/prmaker.api"

# Domínio (Opção A). Mantenha o mapping desligado até verificar o domínio no Search Console.
domain                = "softhouse.app.br"
enable_domain_mapping = false

# Env vars NÃO sensíveis (URLs, flags). As connection strings ficam em secret_values (abaixo).
# Antes do cutover use as URLs *.run.app; depois do domínio no ar, use os subdomínios abaixo.
plain_env = {
  pullrequest = {
    "Auth__UrlBase"               = "https://auth.softhouse.app.br/api"
    "RealTime__AllowedOrigins__0" = "https://app.softhouse.app.br"
  }
  auth = {
    "App__WebBaseUrl" = "https://app.softhouse.app.br"
  }
}

secret_values = {
  # API principal
  "mysql-default-connection"  = "Server=db31021.public.databaseasp.net; Database=db31021; Uid=db31021; Pwd=SENHA; SslMode=Preferred;"
  "sqlserver-auth-connection" = "Server=db30567.public.databaseasp.net; Database=db30567; User Id=db30567; Password=SENHA; Encrypt=True; TrustServerCertificate=True; MultipleActiveResultSets=True;"
  "jwt-secret"                = "TROCAR-por-novo-segredo-jwt"
  "azuredevops-pat"           = "TROCAR-pat-azure-devops"
  "github-token"              = "TROCAR-token-github"
  "realtime-apikey"           = "TROCAR-apikey-realtime"
  # Relay de tempo real (feature 0013) — gere com  openssl rand -base64 48  e repita os mesmos
  # valores nos secrets do GitHub REALTIME_RELAY_KEY / REALTIME_TOKEN_SIGNING_KEY.
  "realtime-relay-key"         = "TROCAR-openssl-rand-base64-48"
  "realtime-token-signing-key" = "TROCAR-openssl-rand-base64-48"
  # Chave AES-256 (32 bytes Base64) das integrações pessoais: gere com  openssl rand -base64 32
  # Não troque depois de em uso (os tokens salvos pelos usuários ficariam ilegíveis).
  "user-integrations-encryption-key" = "TROCAR-openssl-rand-base64-32"

  # Auth API
  "email-password" = "TROCAR-senha-smtp"
}
